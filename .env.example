# Get these connection details and CA certificate from Aiven.
DB_HOST=PASTE_AIVEN_HOST_HERE
DB_PORT=PASTE_AIVEN_PORT_HERE
DB_USER=PASTE_AIVEN_USER_HERE
DB_PASSWORD=PASTE_AIVEN_PASSWORD_HERE
DB_NAME=PASTE_AIVEN_DATABASE_NAME_HERE
DB_CA="PASTE_AIVEN_CA_CERTIFICATE_HERE"

# Get the project URL and service role key from Supabase; choose bucket names in Supabase Storage.
SUPABASE_URL=PASTE_SUPABASE_URL_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_REQUIREMENTS_BUCKET=PASTE_REQUIREMENTS_BUCKET_NAME_HERE
SUPABASE_TEMPLATES_BUCKET=PASTE_TEMPLATES_BUCKET_NAME_HERE

# Get the API key and verified sender details from Brevo.
BREVO_API_KEY=PASTE_BREVO_API_KEY_HERE
BREVO_SENDER_EMAIL=PASTE_BREVO_VERIFIED_SENDER_EMAIL_HERE
BREVO_SENDER_NAME=PASTE_BREVO_SENDER_NAME_HERE

# Generate a long random secret yourself.
JWT_SECRET=PASTE_GENERATED_SECRET_HERE
